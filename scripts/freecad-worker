#!/usr/bin/env bash
# scripts/freecad-worker — installed to bin/freecad-worker
# Launch FreeCAD in persistent worker mode for ElixiCad.
#
# Environment variables:
#   FREECAD_PATH       Path to the FreeCAD binary (default: auto-detected)
#   FREECAD_WORKER_PY  Path to cadclaude_worker.py (default: derived from this
#                      script's location as ../Mod/CadClaude/cadclaude_worker.py)
set -euo pipefail

# ── Resolve FreeCAD binary ────────────────────────────────────────────────────
FREECAD_BIN="${FREECAD_PATH:-}"

if [ -z "$FREECAD_BIN" ]; then
    _SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -x "$_SELF_DIR/../MacOS/FreeCADCmd" ]; then
        # Installed layout: cmake puts FreeCADCmd in MacOS/ (app bundle convention)
        FREECAD_BIN="$_SELF_DIR/../MacOS/FreeCADCmd"
    elif [ -x "$_SELF_DIR/../MacOS/FreeCAD" ]; then
        FREECAD_BIN="$_SELF_DIR/../MacOS/FreeCAD"
    elif [ -x "/Applications/FreeCAD.app/Contents/MacOS/FreeCADCmd" ]; then
        FREECAD_BIN="/Applications/FreeCAD.app/Contents/MacOS/FreeCADCmd"
    elif [ -x "/Applications/FreeCAD.app/Contents/MacOS/FreeCAD" ]; then
        FREECAD_BIN="/Applications/FreeCAD.app/Contents/MacOS/FreeCAD"
    elif command -v freecadcmd &>/dev/null; then
        FREECAD_BIN="$(command -v freecadcmd)"
    elif command -v FreeCADCmd &>/dev/null; then
        FREECAD_BIN="$(command -v FreeCADCmd)"
    else
        echo "freecad-worker: FreeCAD binary not found." \
             "Install FreeCAD or set FREECAD_PATH." >&2
        exit 1
    fi
fi

# ── Resolve worker script ─────────────────────────────────────────────────────
WORKER_PY="${FREECAD_WORKER_PY:-}"

if [ -z "$WORKER_PY" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    # Installed layout:  bin/freecad-worker  → ../Mod/CadClaude/
    # Dev/source layout: scripts/freecad-worker → ../src/Mod/CadClaude/
    if [ -f "$SCRIPT_DIR/../Mod/CadClaude/cadclaude_worker.py" ]; then
        WORKER_PY="$SCRIPT_DIR/../Mod/CadClaude/cadclaude_worker.py"
    else
        WORKER_PY="$SCRIPT_DIR/../src/Mod/CadClaude/cadclaude_worker.py"
    fi
fi

if [ ! -f "$WORKER_PY" ]; then
    echo "freecad-worker: cadclaude_worker.py not found at $WORKER_PY" >&2
    echo "freecad-worker: Set FREECAD_WORKER_PY to override." >&2
    exit 1
fi

# ── macOS dynamic library path ───────────────────────────────────────────────
# FreeCADCmd's rpath only lists /usr/local/lib. On a custom build the libs live
# in ../lib relative to the binary.  Qt6 and other deps come from miniforge3.
# DYLD_LIBRARY_PATH is stripped by SIP for system binaries but works for
# unsigned custom builds like ours.
_FREECAD_INSTALL_DIR="$(cd "$(dirname "$FREECAD_BIN")/.." && pwd)"
_FREECAD_LIB_DIR="$_FREECAD_INSTALL_DIR/lib"
_CONDA_LIB_DIR="${CONDA_PREFIX:-$HOME/miniforge3}/lib"

if [ -d "$_FREECAD_LIB_DIR" ] || [ -d "$_CONDA_LIB_DIR" ]; then
    export DYLD_LIBRARY_PATH="${_FREECAD_LIB_DIR}:${_CONDA_LIB_DIR}${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
fi

# ── Custom OCCT lib dir (only when needed) ───────────────────────────────────
# On machines with a custom-built OpenCascade (not the Homebrew/conda-shipped
# version), Part.so's @rpath OCCT references (libTKFillet.dylib etc.) don't
# resolve from _FREECAD_LIB_DIR or _CONDA_LIB_DIR above, so a plain `import
# Part` fails with "Library not loaded: @rpath/libTKFillet.*.dylib". Only
# probe/append when that OCCT lib isn't already reachable, so machines where
# it resolves fine (system OCCT, or already on DYLD_LIBRARY_PATH) are left
# untouched.
_OCCT_PROBE_LIB="libTKFillet"

# True if any colon-separated directory in $1 contains a file matching
# "${_OCCT_PROBE_LIB}.*". Iterates with IFS=':' so each entry is checked as
# its own argument (a naive "${VAR//:/ }" substitution inside double quotes
# does NOT word-split — it hands ls one bogus multi-dir string — so this
# must not be "simplified" back to that form).
_occt_lib_on_path() {
    local _dirs="$1" _d
    local _oldifs="$IFS"
    IFS=':'
    for _d in $_dirs; do
        IFS="$_oldifs"
        [ -n "$_d" ] || continue
        if ls "$_d" 2>/dev/null | grep -q "^${_OCCT_PROBE_LIB}\."; then
            return 0
        fi
        IFS=':'
    done
    IFS="$_oldifs"
    return 1
}

if ! { [ -n "${DYLD_LIBRARY_PATH:-}" ] && _occt_lib_on_path "$DYLD_LIBRARY_PATH"; } \
   && ! ls "$_FREECAD_LIB_DIR" 2>/dev/null | grep -q "^${_OCCT_PROBE_LIB}\."; then
    _OCCT_LIB_DIR="${OCCT_LIB_DIR:-}"

    if [ -z "$_OCCT_LIB_DIR" ]; then
        # Derive from an installed module's @rpath OCCT reference (e.g.
        # Part.so -> @rpath/libTKFillet.8.0.dylib), then search common OCCT
        # install roots for a lib/ dir containing that exact file.
        _OCCT_DYLIB_NAME=""
        for _mod in "$_FREECAD_LIB_DIR"/*.so; do
            [ -f "$_mod" ] || continue
            _ref="$(otool -L "$_mod" 2>/dev/null | awk -v p="$_OCCT_PROBE_LIB" '$1 ~ "@rpath/" p "\\." {print $1; exit}')"
            if [ -n "$_ref" ]; then
                _OCCT_DYLIB_NAME="${_ref#@rpath/}"
                break
            fi
        done

        if [ -n "$_OCCT_DYLIB_NAME" ]; then
            for _candidate in \
                "$HOME/dev/OCCT/install/lib" \
                "/Users/user/dev/OCCT/install/lib"
            do
                if [ -f "$_candidate/$_OCCT_DYLIB_NAME" ]; then
                    _OCCT_LIB_DIR="$_candidate"
                    break
                fi
            done
        fi
    fi

    # Last-resort fallback: known custom OCCT install location on this machine.
    if [ -z "$_OCCT_LIB_DIR" ] && [ -d "/Users/user/dev/OCCT/install/lib" ]; then
        _OCCT_LIB_DIR="/Users/user/dev/OCCT/install/lib"
    fi

    if [ -n "$_OCCT_LIB_DIR" ] && [ -d "$_OCCT_LIB_DIR" ]; then
        export DYLD_LIBRARY_PATH="${_OCCT_LIB_DIR}${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
    fi
fi

# ── Launch ────────────────────────────────────────────────────────────────────
# -c puts FreeCAD in console mode (RunMode=Cmd, no GUI).
# The inline Python string is not a valid filesystem path so FreeCAD falls
# through to runString() (Application.cpp:processCmdLineFiles), executing it
# directly in the __main__ context.
# runpy.run_path ensures __name__ == '__main__' so the guard at the bottom of
# cadclaude_worker.py fires and main() is called.
exec "$FREECAD_BIN" -c \
    "import runpy; runpy.run_path('${WORKER_PY}', run_name='__main__')"
